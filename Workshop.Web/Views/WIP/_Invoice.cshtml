@model IEnumerable<Workshop.Core.DTOs.WIPInvoiceDTO>;
@using Workshop.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Common> Common
@inject IStringLocalizer<Messages> Message
@using DocumentFormat.OpenXml.Drawing.Diagrams;
@using Newtonsoft.Json;
@using System.Globalization;
@using System.Text;
@using System.Text.Json;

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover mb-3" id="tblInvoiceList">
                <thead>
                    <tr class="small text-muted">
                        <th>@Common["Label_AccountType"]</th>
                        <th>@Common["Label_InvoiceNo"]</th>
                        <th>@Common["Label_InvoiceType"]</th>
                        <th>@Common["Label_ReferanceNo"]</th>
                        <th>@Common["Label_Date"]</th>
                        <th>@Common["Label_Total"]</th>
                        <th>@Common["Label_Discount"]</th>
                        <th>@Common["Label_Tax"]</th>
                        <th>@Common["Label_Net"]</th>
                        <th>@Common["Label_Action"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (item.AccountType == 1)
                                    {
                                        <label>@Common["Label_Internal"]</label>
                                    }
                                    else
                                    {
                                        <label>
                                            @Common["Label_External"]
                                        </label>
                                    }
                                </td>
                                <td>@item.InvoiceNo</td>
                                <td>
                                    @if (item.InvoiceType==1)
                                    {
                                        <label>@Common["Label_Invoice"]</label>
                                    }
                                    else
                                    {
                                        <label>
                                            @Common["Label_CreditNote"]
                                        </label>
                                    }
                                </td>
                                <td>@item.ReferanceNo</td>
                                <td>@item.InvoiceDate.Value.ToString("dd-MM-yyyy")</td>
                                <td>@item.Total.Value.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@item.Discount.Value.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@item.Tax.Value.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@item.Net.Value.ToString(CultureInfo.InvariantCulture)</td>
                                <td>
                                    @if (@item.AccountType==1)
                                    {
                                        <a href="@Url.Action("PrintInternal", "WIP")?WIPId=@item.WIPId&TransactionMasterId=@item.TransactionMasterId&InvoiceNo=@item.InvoiceNo&InvoiceType=@item.InvoiceType" class="btn btn-outline-primary btn-sm collapsed" target="_blank">
                                            <i class="fas fa-print"></i> @Common["Button_Print"]

                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("PrintExternal", "WIP")?InvoiceType=@item.InvoiceType&InvoiceNo=@item.InvoiceNo" class="btn btn-outline-primary btn-sm collapsed" target="_blank">
                                            <i class="fas fa-print"></i>  @Common["Button_Print"]
                                        </a>
                                    }

                                    @if (item.IsReturn ==false && item.InvoiceType==1)
                                    {
                                        <button class="btn btn-outline-primary btn-sm " onclick=CreditNote("@item.WIPId")>
                                            <i class="fas fa-print"></i> @Common["Label_CreditNote"]
                                        </button>
                                    }

                                </td>
        
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-3">
                                <i class="fas fa-info-circle me-2"></i>
                                @Common["NoInvoicesFound"]
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>



<script>
  
   
</script>
<script src="~/js/definitions/invoicetab.js"></script>