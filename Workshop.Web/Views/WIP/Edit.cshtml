<script>
	(function createLeaveGuard() {
	  const state = {
		dirty: false,
		bypass: false,
		confirmOpen: false,
		guardReady: false,
		observerActive: false,
		fallbackUrl: null,
	  };

	  const MSG = "You have unsaved changes. Leave this page?";

	  // -----------------------------
	  // Public API
	  // -----------------------------
	  window.LeaveGuard = {
		markDirty() { state.dirty = true; },
		resetDirty() { state.dirty = false; },
		isDirty() { return state.dirty; },

		// Use this when YOU intentionally navigate (after save, etc.)
		bypassOnce() {
		  state.bypass = true;
		  setTimeout(() => (state.bypass = false), 0);
		},

		navigate(url) {
		  if (!url) return;

		  if (!state.dirty || state.bypass) {
			window.location.href = url;
			return;
		  }

		  confirmLeave(() => {
			state.bypass = true;
			window.location.href = url;
		  });
		},

		back() {
		  attemptLeaveByBack();
		},

		setFallbackUrl(url) {
		  state.fallbackUrl = url;
		}
	  };

	  // Default fallback (your list page) if available
	  if (window.URLs && window.URLs.indexUrl) {
		state.fallbackUrl = window.URLs.indexUrl;
	  }

	  // -----------------------------
	  // Confirm UI (Bootstrap modal if exists, else window.confirm)
	  // -----------------------------
	  function confirmLeave(onLeave) {
		if (state.confirmOpen) return;
		state.confirmOpen = true;

		const modalEl = document.getElementById("leaveConfirmModal");

		// Bootstrap modal path
		if (window.bootstrap && modalEl) {
		  const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
		  const leaveBtn = modalEl.querySelector("#leaveConfirmBtn");

		  let decided = false;

		  const cleanup = () => {
			if (leaveBtn) leaveBtn.removeEventListener("click", onLeaveClick);
			modalEl.removeEventListener("hidden.bs.modal", onHidden);
			state.confirmOpen = false;
		  };

		  const onLeaveClick = () => {
			if (decided) return;
			decided = true;
			cleanup();
			modal.hide();
			onLeave();
		  };

		  const onHidden = () => {
			// User closed modal or clicked "Stay"
			if (decided) return;
			decided = true;
			cleanup();
		  };

		  if (leaveBtn) leaveBtn.addEventListener("click", onLeaveClick);
		  modalEl.addEventListener("hidden.bs.modal", onHidden);

		  modal.show();
		  return;
		}

		// Fallback confirm
		const ok = window.confirm(MSG);
		state.confirmOpen = false;
		if (ok) onLeave();
	  }

	  // -----------------------------
	  // Dirty detection
	  // -----------------------------
	  document.addEventListener("input", (e) => {
		if (e.target && e.target.matches("input, textarea")) state.dirty = true;
	  }, true);

	  document.addEventListener("change", (e) => {
		if (!e.target) return;
		if (e.target.matches("select, input[type=checkbox], input[type=radio], input[type=file]")) {
		  state.dirty = true;
		}
	  }, true);

	  // MutationObserver (activates after first user gesture)
	  const observer = new MutationObserver(() => {
		state.dirty = true;
	  });

	  function activateObserverOnce() {
		if (state.observerActive) return;
		state.observerActive = true;

		observer.observe(document.body, {
		  childList: true,
		  subtree: true,
		  attributes: true,
		  characterData: true,
		});
	  }

	  ["click", "keydown", "touchstart"].forEach((evt) => {
		window.addEventListener(evt, activateObserverOnce, { once: true, capture: true });
	  });

	  // -----------------------------
	  // IMPORTANT CHANGE:
	  // We REMOVED beforeunload guard so page reload works with NO alert.
	  // (This also means closing the tab won't show the unsaved warning.)
	  // -----------------------------

	  // -----------------------------
	  // History guard (Back button fix)
	  // -----------------------------
	  function initHistoryGuard() {
		if (state.guardReady) return;
		state.guardReady = true;

		const baseState = Object.assign({}, history.state || {}, { __LG_BASE: true });
		history.replaceState(baseState, "", window.location.href);

		const guardState = { __LG_GUARD: true };
		history.pushState(guardState, "", window.location.href);
	  }

	  initHistoryGuard();

	  function attemptLeaveByBack() {
		if (!state.dirty || state.bypass) {
		  state.bypass = true;
		  history.back();
		  setTimeout(() => (state.bypass = false), 0);
		  return;
		}

		confirmLeave(() => {
		  state.bypass = true;
		  history.go(-2);

		  // Fallback if there is no real history (opened in new tab)
		  const currentUrl = window.location.href;
		  setTimeout(() => {
			if (window.location.href === currentUrl && state.fallbackUrl) {
			  window.location.href = state.fallbackUrl;
			}
		  }, 600);
		});
	  }

	  window.addEventListener("popstate", (e) => {
		if (state.bypass) return;

		const st = e.state || {};

		if (st.__LG_BASE) {
		  if (state.dirty) {
			history.pushState({ __LG_GUARD: true }, "", window.location.href);

			confirmLeave(() => {
			  state.bypass = true;
			  history.go(-2);

			  const currentUrl = window.location.href;
			  setTimeout(() => {
				if (window.location.href === currentUrl && state.fallbackUrl) {
				  window.location.href = state.fallbackUrl;
				}
			  }, 600);
			});
		  } else {
			state.bypass = true;
			history.back();
			setTimeout(() => (state.bypass = false), 0);
		  }
		}
	  });

	  // -----------------------------
	  // CLICK HANDLING
	  // - Back to list
	  // - Optional custom back
	  // - Other same-tab links
	  // -----------------------------
	  document.addEventListener("click", (e) => {
		// 1) Back to list explicit
		const backToListBtn = e.target.closest("#btnBackToList");
		if (backToListBtn) {
		  // allow ctrl/cmd/middle click to open in new tab normally
		  if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;

		  e.preventDefault();
		  const url =
			backToListBtn.getAttribute("href") ||
			(window.URLs && window.URLs.indexUrl) ||
			state.fallbackUrl;

		  window.LeaveGuard.navigate(url);
		  return;
		}

		// 2) Optional: custom back button support
		const backBtn = e.target.closest("[data-leave-guard-back]");
		if (backBtn) {
		  e.preventDefault();
		  attemptLeaveByBack();
		  return;
		}

		// 3) General link guard (same-tab navigations)
		const a = e.target.closest("a[href]");
		if (!a) return;

		if (a.target && a.target !== "_self") return;
		if (a.hasAttribute("download")) return;
		if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;

		const href = a.getAttribute("href");
		if (!href || href.startsWith("#") || href.startsWith("javascript:")) return;

		const url = new URL(href, window.location.href);
		if (url.href === window.location.href) return;

		if (!state.dirty || state.bypass) return;

		e.preventDefault();
		confirmLeave(() => {
		  state.bypass = true;
		  window.location.href = url.href;
		});
	  }, true);

	  // Let form submits proceed
	  document.addEventListener("submit", () => {
		state.bypass = true;
		setTimeout(() => (state.bypass = false), 0);
	  }, true);

	})();
</script>