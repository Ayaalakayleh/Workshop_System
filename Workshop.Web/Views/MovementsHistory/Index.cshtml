@model Workshop.Core.DTOs.WorkshopMovement.WorkshopMovementFilter
@using Workshop.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Common> Common
@inject IStringLocalizer<Messages> Message
@{
    ViewBag.Title = Common["Movement"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row">
    <div class="col-12">
        <div id="panel-1" class="panel">
            <div class="panel-hdr px-2">
                <h2 class="font-weight-bold">@Common["Movements History"]</h2>
            </div>
            <div class="panel-container show">
                <div class="panel-content text-start">

                    <form>
                        <div class="row">

                            <div class="col-md-3 col-sm-12">
                                <div class="form-group">
                                    <label>@Common["Label_Vehicle"]</label>
                                    @Html.DropDownListFor(model => model.VehicleID, new SelectList(Model.vehicleNams, "id", "VehicleName"), Common["Select"], htmlAttributes: new { @class = "form-control" })
                                </div>
                            </div>

                            <div class="col-md-3 col-sm-12">
                                <div class="form-group" id="mYear">
                                    <label>@Common["Label_FromDate"]</label>
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.FromDate, new { htmlAttributes = new { @class = "form-control flat-picker", id = "FromDate", type = "date" } })
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3 col-sm-12">
                                <div class="form-group" id="mYear">
                                    <label>@Common["Label_ToDate"]</label>
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.ToDate, new { htmlAttributes = new { @class = "form-control flat-picker", id = "ToDate", type = "date" } })
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3 text-start mt-3">
                                <div class="custom-control custom-switch mt-1">
                                    @Html.CheckBox("MovementIN", new { @class = "custom-control-input" })
                                    <label class="custom-control-label" for="MovementIN">@Common["MovementIn"]</label>
                                </div>
                                <div class="custom-control custom-switch mt-1">
                                    @Html.CheckBox("MovementOut", new { @class = "custom-control-input" })
                                    <label class="custom-control-label" for="MovementOut">@Common["Label_MovementOut"]</label>
                                </div>
                            </div>
                        </div>

                        <div class="text-center mt-3">
                            <button id="searchVehicleMovment" type="button" class="btn btn-primary btn-w-m">
                                <i class="fa fa-search"></i>&nbsp;@Common["Button_Search"]
                            </button>
                            <button id="reset-fields" type="reset" class="btn btn-secondary btn-w-m">
                                <i class="fa fa-times"></i>&nbsp;@Common["Button_Reset"]
                            </button>
                            <input type="hidden" id="hidSearchVehicleDefinitions" value="0" />
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

<div id="MovementList"></div>
<div id="contentPager" hidden></div>

<script src="~/js/site.js"></script>

<script>
    $(document).ready(function () {
        getData(1);

        $("#searchVehicleMovment").on("click", function () {
            getData(1);
        });

        $("#reset-fields").on("click", function () {
            setTimeout(function () {
                getData(1);
            }, 50);
        });

        function getData(page) {
            var MovementIn = $('#MovementIN').is(":checked");
            var MovementOut = $('#MovementOut').is(":checked");
            var VehicleID = $('#VehicleID').val();
            var FromDate = $("#FromDate").val();
            var ToDate = $("#ToDate").val();

            var vehicleMovementFilter = {
                VehicleID: VehicleID,
                page: page,
                FromDate: FromDate,
                ToDate: ToDate,
                MovementIN: MovementIn,
                MovementOut: MovementOut
            };

            $.ajax({
                type: 'POST',
                url: '@Url.Action("MovementList", "MovementsHistory")',
                dataType: 'html',
                data: vehicleMovementFilter
            }).done(function (result) {
                $("#MovementList").html(result);

                var totalPages = parseInt($("#total_pages").val(), 10);

                if (!isNaN(totalPages) && totalPages > 0) {
                    $("#contentPager").removeAttr("hidden");

                    if ($('#contentPager').data("pagination")) {
                        $('#contentPager').pagination('destroy');
                    }

                    $("#contentPager").empty();

                    $('#contentPager').pagination({
                        items: totalPages,
                        itemsOnPage: 1,
                        currentPage: page,
                        cssStyle: 'light-theme',
                        prevText: 'Previous',
                        nextText: 'Next',
                        onPageClick: function (pageNumber, event) {
                            if (event) {
                                event.preventDefault();
                            }
                            getData(pageNumber);
                        }
                    });
                } else {
                    if ($('#contentPager').data("pagination")) {
                        $('#contentPager').pagination('destroy');
                    }

                    $("#contentPager").attr("hidden", true).empty();
                }
            }).fail(function () {
                $("#MovementList").html('<div class="alert alert-danger">Error loading data.</div>');
                $("#contentPager").attr("hidden", true).empty();
            });
        }
    });
</script>