@model ServiceReminderPageVM
@using Workshop.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Common> Common
@inject IStringLocalizer<Messages> Message

@{
    ViewBag.Title = Common["EditServiceReminder"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .is-invalid {
        border-color: #dc3545 !important;
    }

    .select2-container .select2-selection.is-invalid {
        border: 1px solid #dc3545 !important;
    }
</style>

<div class="row">
    <div class="col-lg-8 col-md-6 col-sm-12">
        <div id="panel-form" class="panel">
            <div class="panel-hdr">
                <h2 class="font-weight-bold">@Common["ServiceReminder"]</h2>
            </div>
            <div class="panel-container show">
                <div class="panel-content">
                    <div class="row">
                        <div class="col-12">

                            <form id="serviceReminderForm" asp-action="Edit" asp-controller="ServiceReminder" method="post">
                                <div class="row">

                                    @Html.EditorFor(model => model.ReminderForm.Id, new { htmlAttributes = new { @class = "form-control", @type = "hidden", @readonly = "readonly" } })
                                    <div class="col-md-6 mb-3">
                                        <label>@Common["Label_Vehicle"]</label>
                                        @Html.HiddenFor(model => model.ReminderForm.VehicleId)
                                        @Html.DropDownListFor(
                                        model => model.ReminderForm.VehicleId,
                                                                                new SelectList(ViewBag.vehicle, "Value", "Text"),
                                                                                "@Common['Select']",
                                                                                new { @class = "form-control", disabled = "disabled" }
                                                                                )
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label>@Common["Label_Year"] <span class="text-danger">*</span></label>
                                        @Html.HiddenFor(model => model.ReminderForm.ManufacturingYear)
                                        @Html.EditorFor(
                                                                                model => model.ReminderForm.ManufacturingYear,
                                                                                new { htmlAttributes = new { @class = "form-control", @type = "number", @required = "required", disabled = "disabled" } }
                                                                                )
                                        <span class="text-danger field-validation-error" id="yearValidationMsg"></span>

                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label>@Common["Manufacturer"]</label>
                                        @Html.HiddenFor(model => model.ReminderForm.ManufacturerId)
                                        @Html.DropDownListFor(
                                        model => model.ReminderForm.ManufacturerId,
                                                                                new SelectList(ViewBag.manufacturers, "Value", "Text"),
                                                                                "@Common['Select']",
                                                                                new { @class = "form-control", id = "ManufacturerId", disabled = "disabled" }
                                                                                )
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label>@Common["Label_Model"]</label>
                                        @Html.HiddenFor(model => model.ReminderForm.VehicleModelId)
                                        @Html.DropDownListFor(
                                                                                model => model.ReminderForm.VehicleModelId,
                                                                                new SelectList(ViewBag.vehiclesModels, "Value", "Text"),
                                                                                "Select",
                                                                                new { @class = "form-control", id = "VehicleModelId", disabled = "disabled" }
                                                                                )
                                    </div>



                                    <div class="col-12 mb-3">
                                        <label>@Common["Label_VechileType"]</label>
                                       
                                        @Html.DropDownListFor(
                                                                                model => model.ReminderForm.VehicleGroupId,
                                                                                new SelectList(ViewBag.vehicleClasss, "Value", "Text"),
                                                                                "Select",
                                                                                new { @class = "form-control" }
                                                                                )
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label>@Common["Label_Services"]</label>
                                        @Html.HiddenFor(model => model.ReminderForm.ItemId)
                                        @Html.DropDownListFor(
                                                                                model => model.ReminderForm.ItemId,
                                                                                new SelectList(ViewBag.services, "Value", "Text"),
                                                                                "Select",
                                                                                new { @class = "form-control", disabled = "disabled" }
                                                                                )
                                        <span class="text-danger field-validation-error" id="serviceValidationMsg"></span>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label>@Common["Label_Repeats"]</label>
                                        @Html.EditorFor(
                                                                                model => model.ReminderForm.Repates,
                                                                                new { htmlAttributes = new { @class = "form-control", @type = "number", @placeholder = @Common["Every"] } }
                                                                                )
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label>@Common["Label_TimeInterval"]</label>
                                        <div class="input-group flex-nowrap">
                                            @Html.EditorFor(
                                                                                        model => model.ReminderForm.TimeInterval,
                                                                                        new { htmlAttributes = new { @class = "form-control", @type = "number", @placeholder = @Common["Every"] } }
                                                                                        )
                                            @Html.DropDownListFor(
                                                                                        model => model.ReminderForm.TimeIntervalUnit,
                                                                                        new SelectList(ViewBag.dateUnits, "Value", "Text"),
                                                                                        "Select",
                                                                                        new { @class = "form-control no-select2" }
                                                                                        )
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label>@Common["Label_TimeDuo"]</label>
                                        <div class="input-group flex-nowrap">
                                            @Html.EditorFor(
                                                                                        model => model.ReminderForm.TimeDue,
                                                                                        new { htmlAttributes = new { @class = "form-control", @type = "number", @placeholder = @Common["Every"] } }
                                                                                        )
                                            @Html.DropDownListFor(
                                                                                        model => model.ReminderForm.TimeDueUnit,
                                                                                        new SelectList(ViewBag.dateUnits, "Value", "Text"),
                                                                                        "Select",
                                                                                        new { @class = "form-control no-select2" }
                                                                                        )
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label>@Common["Label_PrimaryMeterInterval"]</label>
                                        <div class="input-group flex-nowrap">
                                            @Html.EditorFor(
                                                                                        model => model.ReminderForm.PrimaryMeterInterval,
                                                                                        new { htmlAttributes = new { @class = "form-control", @type = "number", @placeholder = @Common["Every"] } }
                                                                                        )
                                            <div class="input-group-append">
                                                <span class="input-group-text">@Common["Unit_Kilometer"]</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label>@Common["Label_PrimaryMeterDue"]</label>
                                        <div class="input-group flex-nowrap">
                                            @Html.EditorFor(
                                                                                        model => model.ReminderForm.PrimaryMeterDue,
                                                                                        new { htmlAttributes = new { @class = "form-control", @type = "number", @placeholder = @Common["Every"] } }
                                                                                        )
                                            <div class="input-group-append">
                                                <span class="input-group-text">@Common["Unit_Kilometer"]</span>
                                            </div>
                                        </div>
                                    </div>
                                    

                                    <div class="col-12">
                                        <div class="panel-tag">
                                            @Common["NotificationsDescription"]
                                        </div>
                                    </div>

                                </div>
                                <div class="row mt-2">
                                    <div class="col-md-4 col-sm-12">
                                        <div class="form-check form-switch">
                                            @Html.CheckBoxFor(model => model.ReminderForm.IsManually, htmlAttributes: new { @class = "form-check-input", id = "IsManually" })
                                            <label class="form-check-label" for="IsManually">@Common["Manually"]</label>
                                        </div>

                                        <div id="ManualControl" class="custom-control collapse">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.ReminderForm.ManualDate, @Common["ManualDate"])
                                                    @Html.TextBoxFor(model => model.ReminderForm.ManualDate, new { @class = "form-control flat-picker", type = "date" })
                                                </div>

                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.ReminderForm.ManualPrimaryMeter, @Common["Label_ManualMeterInterval"])
                                                    <div class="input-group flex-nowrap">
                                                        @Html.TextBoxFor(model => model.ReminderForm.ManualPrimaryMeter, new { @class = "form-control", type = "number", @placeholder = @Common["Every"] })
                                                        <div class="input-group-append">
                                                            <span class="input-group-text">@Common["Unit_Kilometer"]</span>
                                                        </div>
                                                    </div>
                                                </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-12">
                                        <div class="form-check form-switch">
                                            @Html.CheckBoxFor(model => model.ReminderForm.UseSameStart, htmlAttributes: new { @class = "form-check-input", id = "UseSameStart" })
                                            <label class="form-check-label" for="UseSameStart">@Common["UseSameStart"]</label>
                                        </div>

                                        <div id="StartDateControl" class="custom-control collapse">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.ReminderForm.StartDate, @Common["StartDate"])
                                                    <input type="date"
                                                           class="form-control"
                                                           id="ReminderForm_StartDate"
                                                           name="ReminderForm.StartDate"
                                                       disabled="disabled"
                                                           value="@(Model.ReminderForm.StartDate.HasValue? Model.ReminderForm.StartDate.Value.ToString("yyyy-MM-dd") : "")" />
                                                </div>

                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.ReminderForm.StartMeter, @Common["StartMeter"])
                                                    <div class="input-group flex-nowrap">
                                                    @Html.TextBoxFor(model => model.ReminderForm.StartMeter, new { @class = "form-control", type = "number", @placeholder = @Common["StartMeter"], disabled = "disabled" })
                                                        <div class="input-group-append">
                                                            <span class="input-group-text">@Common["Unit_Kilometer"]</span>
                                                        </div>
                                                    </div>
                                                </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-12">
                                        <div class="form-check form-switch">
                                            @Html.CheckBoxFor(
                                                                                        model => model.ReminderForm.HasNotification,
                                                                                        new { @class = "form-check-input", id = "HasNotification" }
                                                                                        )
                                            <label class="form-check-label" for="HasNotification">@Common["Notifications"]</label>
                                        </div>

                                        <div id="NoticationsControl" class="custom-control collapse">
                                            @Html.LabelFor(model => model.ReminderForm.NotificationsGroupId, @Common["Notify"])
                                            @Html.DropDownListFor(
                                                                                        m => m.ReminderForm.NotificationsGroupId,
                                                                                        new MultiSelectList(ViewBag.Groups, "Value", "Text"),
                                                                                        "Select",
                                                                                        new { @class = "form-control", @multiple = "multiple" }
                                                                                        )
                                        </div>
                                    </div>
                                </div>
                            </form>

                            <div class="row mt-4">
                                <div class="col-12 text-center">
                                    <button type="submit" class="btn btn-primary" form="serviceReminderForm">
                                        <i class="fas fa-save"></i>&nbsp;@Common["Save"]
                                    </button>
                                    <a href="@Url.Action("Index", "ServiceReminder")" class="btn btn-secondary">
                                        <i class="fas fa-times"></i>&nbsp;@Common["Cancel"]
                                    </a>
                                </div>
                            </div>

                        </div><!-- /.col-12 -->
                    </div><!-- /.row -->
                </div><!-- /.panel-content -->
            </div><!-- /.panel-container -->
        </div>
    </div>
    <div class="col-lg-4 col-md-6 col-sm-12">
        <div id="panel-schedule" class="panel">
            <div class="panel-hdr px-2">
                <h2 class="font-weight-bold">@Common["SchedulePreview"]</h2>
            </div>
            <div class="panel-container show">
                <div class="panel-content">
                    <div class="frame-wrap">
                        <table class="table table-striped m-0 text-center">
                            <thead>
                                <tr>
                                    <th>@Common["Label_Date"]</th>
                                    <th>@Common["Label_PrimaryMeter"]</th>
                                    <th>@Common["Label_IsCompleted"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.ReminderForm.ServiceRemindersSchedules != null && Model.ReminderForm.ServiceRemindersSchedules.Any())
                                {
                                    @foreach (var item in Model.ReminderForm.ServiceRemindersSchedules)
                                    {
                                        <tr>
                                            <td>
                                                <p class="m-0">@(item.Date.HasValue ? item.Date.Value.ToString("dd-MM-yyyy") : "")</p>
                                                @if (item.Date.HasValue && !item.IsCompleted)
                                                {
                                                    var totalDays = Math.Abs((item.Date.Value - DateTime.Now).TotalDays);
                                                    var timeUnit = "";
                                                    var timeValue = 0;

                                                    if (totalDays >= 30)
                                                    {
                                                        timeValue = (int)Math.Round(totalDays / 30);
                                                        timeUnit = timeValue == 1 ? Common["month"] : Common["Months"];
                                                    }
                                                    else if (totalDays >= 7)
                                                    {
                                                        timeValue = (int)Math.Round(totalDays / 7);
                                                        timeUnit = timeValue == 1 ? Common["week"] : Common["Weeks"];
                                                    }
                                                    else
                                                    {
                                                        timeValue = (int)Math.Round(totalDays);
                                                        timeUnit = timeValue == 1 ? Common["day"] : Common["Days"];
                                                    }

                                                    var datediff = item.Date.Value > DateTime.Now
                                                    ? $"{timeValue} {timeUnit} {Common["FromNow"]}"
                                                    : $"{timeValue} {timeUnit} {Common["Ago"]}";

                                                    <small class="text-muted">@datediff</small>
                                                }
                                            </td>
                                            <td>
                                                <p class="m-0">@(item.PrimaryMeter.HasValue ? $"{item.PrimaryMeter.Value:F2} {Common["Unit_Kilometer"]}" : "")</p>
                                                @if (item.PrimaryMeter.HasValue && !item.IsCompleted)
                                                {
                                                    var meterDiff = item.PrimaryMeter.Value - Model.ReminderForm.CurrentMeter;
                                                    <small class="text-muted">@(meterDiff > 0 ? $"{meterDiff:F1} {Common["Unit_Kilometer"]} {Common["FromNow"]}" : $"{Math.Abs(meterDiff):F1} {Common["Unit_Kilometer"]} {Common["Ago"]}")</small>
                                                }
                                            </td>
                                            <td>
                                                <i class="@(item.IsCompleted ? "fas fa-check text-success" : "fas fa-times text-danger")"></i>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted">
                                            @Common["NoScheduleData"]
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
    </div>
    
</div>
<script>
    // Shared variables for other scripts
    var RazorVars = {
        swalDeleteTitle: '@Message["SwalDeleteTitle"]',
        swalDeleteConfirm: '@Message["SwalDeleteConfirm"]',
        swalDeleteCancel: '@Message["SwalDeleteCancel"]',
        swalErrorHappened: '@Message["ErrorHappened"]',
        swalDeleted: '@Message["Deleted"]',
        swalCancelled: '@Message["Cancelled"]',
        btnSave: '@Html.Raw(Common["Save"])',
        btnSaving: '@Html.Raw(Common["Saving"])',
        btnTryAgain: '@Html.Raw(Common["TryAgain"])',
        btnOk: '@Html.Raw(Common["Ok"])',
        msgSuccessTitle: '@Html.Raw(Common["SuccessTitle"])',
        ErrorHappened: '@Html.Raw(Common["ErrorHappened"])',
        loadingText: '@Html.Raw(Common["Loading"])',
        requiredField: '@Html.Raw(Common["RequiredField"])',
        totalText: '@Html.Raw(Common["Total"])',
        placeholderSelect: '@Html.Raw(Common["Select"])',
        editUrl: '@Url.Action("Edit", "ServiceReminder")',
        getVehicleByManufacturerIdURL: '@Url.Action("GetVehicleByManufacturerId", "ServiceReminder")',
        getDueServiceRemindersURL: '@Url.Action("GetDueServiceReminders", "ServiceReminder")'
    };
</script>

<script src="~/js/Definitions/ServiceReminder.js"></script>
<script src="~/js/Definitions/ServiceReminderEdit.js"></script>
