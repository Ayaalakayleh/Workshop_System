@using Microsoft.Extensions.Localization
@using Workshop.Core.DTOs
@using Workshop.Core.DTOs.General
@using Workshop.Resources
@inject IStringLocalizer<Common> CommonLocalizer
@inject IStringLocalizer<Messages> MessagesLocalizer

<!DOCTYPE html>
<html data-bs-theme="light|dark"
      dir="@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith(" ar") ? "rtl" : "ltr" )"
      lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">

    @{
        var CompanyInfo = System.Text.Json.JsonSerializer.Deserialize <CompanyInfo>(Context.Session.GetString("CompanyInfo"));
        var BranchInfo = System.Text.Json.JsonSerializer.Deserialize<CompanyBranch>(Context.Session.GetString("BranchInfo"));
        var userInfo = System.Text.Json.JsonSerializer.Deserialize<User>(Context.Session.GetString("UserInfo"));
        var menus = System.Text.Json.JsonSerializer.Deserialize<List<Menu>>(Context.Session.GetString("PrimaryMenuList"));
        var lang = System.Globalization.CultureInfo.CurrentUICulture.Name;
    }
    <head>
        <meta charset="utf-8">
        <title>@ViewData["Title"] - @CommonLocalizer["Title_WorkshopSystem"]</title>
        <meta name="description" content="Page Description">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, maximum-scale=5">
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="msapplication-tap-highlight" content="no">
        <base href="@Url.Content(" ~ /")" />

        <!-- DataTables CSS -->
        <link href="~/smartadmin-5-styles/cdn/css/datatables.css" rel="stylesheet" />
        <link href="~/smartadmin-5-styles/cdn/css/datatable-buttons.css" rel="stylesheet" />
        <link href="~/smartadmin-5-styles/cdn/css/datatable-select.css" rel="stylesheet" />
        <link href="~/smartadmin-5-styles/cdn/css/datatables-all.css" rel="stylesheet" />

        <!-- Select2 CSS -->
        <link href="~/smartadmin-5-styles/cdn/css/select2.css" rel="stylesheet" />

        <!-- FilePond CSS -->
        <link href="~/smartadmin-5-styles/cdn/css/filepond.css" rel="stylesheet" />
        <link href="~/smartadmin-5-styles/cdn/css/filepond-image-preview.css" rel="stylesheet" />

        <!-- Flatpickr CSS -->
        <link href="~/smartadmin-5-styles/cdn/css/flatpicker.css" rel="stylesheet" />

        <!-- DX CSS -->
        <link href="~/smartadmin-5-styles/plugins/data-grid/css/dx.common.css" rel="stylesheet" />
        <link id="dx-theme-style" rel="stylesheet" href="~/smartadmin-5-styles/plugins/data-grid/css/dx.light.css" />

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/simplePagination.js/1.6/simplePagination.css" />

        @if (System.Globalization.CultureInfo.CurrentUICulture.Name == "ar")
        {
        <link href="~/smartadmin-5-styles/css/smartapp-rtl.min.css" rel="stylesheet" />
        <link href="~/smartadmin-5-styles/css/custom-styles-rtl.css" rel="stylesheet" />
        }
        else
        {
        <link rel="stylesheet" media="screen, print" href="~/smartadmin-5-styles/css/smartapp.min.css" />
        }

        <link id="theme-style"
              rel="stylesheet"
              href="@Url.Content(" ~ /smartadmin-5-styles/css/themes/earth.css")"
              asp-append-version="true" />

        <script>
            (function () {
                const KEY = 'sa-theme-style';
                const DEFAULT = 'earth';
                const THEMES = ['earth', 'olive', 'nebula', 'solar', 'lunar', 'night', 'aurora', 'flare', 'storm'];
                const base = '@Url.Content("~/smartadmin-5-styles/css/themes/")';

                const saved = (localStorage.getItem(KEY) || '').toLowerCase().trim();
                const theme = THEMES.includes(saved) ? saved : DEFAULT;

                const link = document.getElementById('theme-style');
                if (link) link.href = base + theme + '.css';
            })();
        </script>

        <link rel="stylesheet" media="screen, print" href="~/smartadmin-5-styles/plugins/waves/waves.min.css" />
        <link rel="stylesheet" media="screen, print" href="~/smartadmin-5-styles/webfonts/smartadmin/sa-icons.css" />
        <link rel="stylesheet" media="screen, print" href="~/smartadmin-5-styles/webfonts/fontawesome/fontawesome.css" />
        <link rel="stylesheet" media="screen, print" href="~/smartadmin-5-styles/css/custom-styles.css" />
        <link href="~/smartadmin-5-styles/cdn/css/sweetalert2.css" rel="stylesheet" />

        <!-- International Phone Input -->
        <link href="~/smartadmin-5-styles/plugins/intltelinput/css/intltelinput.min.css" rel="stylesheet" />
        <script src="~/smartadmin-5-styles/plugins/intltelinput/js/intltelinput.min.js"></script>
        <script src="~/smartadmin-5-styles/plugins/intltelinput/js/utils.js"></script>

        <script src="~/smartadmin-5-styles/scripts/core/saveloadscript.js"></script>
        <script src="~/smartadmin-5-styles/plugins/jquery/jquery.min.js"></script>

        <!-- DataTables Core JS -->
        <script src="~/smartadmin-5-styles/cdn/js/datatables.js"></script>
        <script src="~/smartadmin-5-styles/cdn/js/datatables-bootstrap5.js"></script>
        <script src="~/smartadmin-5-styles/cdn/js/datatables-all.js"></script>

        <script src="~/js/loader.js"></script>

        <script>
            var theMainLang = "@lang";
            var theMainSwalOk = '@CommonLocalizer["Ok"]';
        </script>

        @await RenderSectionAsync("Styles", required: false)
    </head>

    <body class="mod-bg-1">
        @RenderBody()

        <!-- JS  -->
        <script src="~/smartadmin-5-styles/cdn/js/validate.js"></script>
        <script src="~/smartadmin-5-styles/cdn/js/validate-new.js"></script>

        <!-- Select2 JS -->
        <script src="~/smartadmin-5-styles/cdn/js/select2.js"></script>

        <!-- Flatpickr JS -->
        <script src="~/smartadmin-5-styles/cdn/js/flatpicker.js"></script>

        <!-- SweetAlert 2 JS -->
        <script src="~/smartadmin-5-styles/cdn/js/sweetalert2.js"></script>

        <!-- DevExpress JS -->
        <script src="https://cdn3.devexpress.com/jslib/23.2.4/js/jszip.min.js"></script>
        <script src="~/smartadmin-5-styles/plugins/data-grid/js/dx.all.js"></script>
        <script src="~/smartadmin-5-styles/plugins/data-grid/js/exceljs.js"></script>
        <script src="~/smartadmin-5-styles/plugins/data-grid/js/filesaver.js"></script>
        <script src="~/smartadmin-5-styles/plugins/data-grid/js/localization/dx.messages.en.js"></script>
        <script src="~/smartadmin-5-styles/plugins/data-grid/js/localization/dx.messages.ar.js"></script>

        <!-- FilePond JS -->
        <script src="~/smartadmin-5-styles/cdn/js/filepond.js"></script>
        <script src="~/smartadmin-5-styles/cdn/js/filepond-image-preview.js"></script>
        <script src="https://unpkg.com/filepond-plugin-file-validate-type/dist/filepond-plugin-file-validate-type.js"></script>
        <script src="https://unpkg.com/filepond-plugin-file-validate-size/dist/filepond-plugin-file-validate-size.js"></script>
        <script src="https://unpkg.com/filepond-plugin-image-exif-orientation/dist/filepond-plugin-image-exif-orientation.js"></script>
        <script src="https://unpkg.com/filepond-plugin-image-resize/dist/filepond-plugin-image-resize.js"></script>
        <script src="https://unpkg.com/filepond-plugin-image-transform/dist/filepond-plugin-image-transform.js"></script>

        <!-- Input Mask -->
        <script src="https://cdn.jsdelivr.net/npm/inputmask@5.0.8/dist/jquery.inputmask.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/simplePagination.js/1.6/jquery.simplePagination.min.js"></script>

        <!-- Core scripts -->
        <script src="~/smartadmin-5-styles/plugins/bootstrap/bootstrap.bundle.min.js"></script>
        <script src="~/smartadmin-5-styles/scripts/core/smartnavigation.js"></script>
        <script src="~/smartadmin-5-styles/scripts/core/smartfilter.js"></script>
        <script src="~/smartadmin-5-styles/scripts/core/smartslimscroll.js"></script>

        <!-- Dependable scripts -->
        <script src="~/smartadmin-5-styles/plugins/sortablejs/sortable.min.js"></script>
        <script src="~/smartadmin-5-styles/plugins/waves/waves.min.js"></script>

        <!-- App.js -->
        <script src="~/smartadmin-5-styles/scripts/core/smartapp.js"></script>

        @if (System.Globalization.CultureInfo.CurrentUICulture.Name == "ar")
        {
        <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/localization/messages_ar.js"></script>
        }

        <script src="~/js/signature/jsignature.js"></script>
        <script src="~/js/signature/plugins/jsignature.compressorbase30.js"></script>
        <script src="~/js/signature/plugins/jsignature.undobutton.js"></script>
        <script src="~/js/signature/plugins/signhere/jsignature.signhere.js"></script>

        <!-- Resources + language switch  -->
        <script>
            function switchLanguage(culture) {
                $.ajax({
                    url: '@Url.Action("SetLanguage", "Language")',
                    type: 'POST',
                    data: {
                        culture: culture,
                        returnUrl: window.location.pathname + window.location.search
                    },
                    success: function () { location.reload(); },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: culture === 'ar' ? 'خطأ!' : 'Error!',
                            text: culture === 'ar' ? 'حدث خطأ أثناء تغيير اللغة' : 'An error occurred while changing the language',
                            confirmButtonText: culture === 'ar' ? 'حسناً' : 'OK'
                        });
                    }
                });
            }

            const resources = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                select = CommonLocalizer["Select"].Value,
                description = CommonLocalizer["Description"].Value,
                drag_drop_files = CommonLocalizer["DragDropFiles"].Value,
                EmptyData = CommonLocalizer["EmptyData"].Value,
                areYouSure = MessagesLocalizer["SwalDeleteTitle"].Value,
                yes = MessagesLocalizer["Yes"].Value,
                no = MessagesLocalizer["No"].Value,
                success = MessagesLocalizer["Success"].Value,
                failed = MessagesLocalizer["Failed"].Value,
                all_required_fields = MessagesLocalizer["AllRequiredFields"].Value,
                required_field = MessagesLocalizer["RequiredField"].Value,
                valid_email = MessagesLocalizer["ValidEmail"].Value,
                error = MessagesLocalizer["Error"].Value,
                error_msg = MessagesLocalizer["ErrorMessage"].Value,
                success_msg = MessagesLocalizer["SuccessMessage"].Value,
                deleted_success = MessagesLocalizer["DeletedSuccess"].Value,
                ok = MessagesLocalizer["Ok"].Value,
                letters_numbers = MessagesLocalizer["LettersNumbers"].Value,
                already_exists = MessagesLocalizer["AlreadyExists"].Value,
                delete_not_allowed = MessagesLocalizer["DeleteNotAllowed"].Value,
                NoDataInTable = CommonLocalizer["NoDataInTable"].Value,
                filepondDragDrop = CommonLocalizer["filepondDragDrop"].Value,
            }));
        </script>

        <!-- DevExtreme theme/rtl sync + datatable error handler + lockFormControls  -->
        <script>
            /* Start DevExtreme Global RTL + Dark + Responsive Sync with SmartAdmin */
            document.addEventListener("DOMContentLoaded", function () {

                if (!window.DevExpress?.ui) return;

                const htmlRoot = document.documentElement;
                const dxThemeLink = document.getElementById("dx-theme-style");
                const DX_LIGHT = '@Url.Content("~/smartadmin-5-styles/plugins/data-grid/css/dx.light.css")';
                const DX_DARK = '@Url.Content("~/smartadmin-5-styles/plugins/data-grid/css/dx.dark.css")';

                function isDark() { return (htmlRoot.getAttribute("data-bs-theme") || "light") === "dark"; }
                function isRTL() { return (htmlRoot.getAttribute("dir") || "ltr").toLowerCase() === "rtl"; }

                function isPhone() {
                    try { return DevExpress.devices.current().deviceType === "phone"; }
                    catch (e) { return window.innerWidth < 768; }
                }

                function updateAllDxTables() {
                    document.querySelectorAll(".dx-datagrid").forEach(el => {
                        const grid = DevExpress.ui.dxDataGrid.getInstance(el);
                        if (grid) { grid.updateDimensions(); grid.repaint(); }
                    });
                    document.querySelectorAll(".dx-treelist").forEach(el => {
                        const tree = DevExpress.ui.dxTreeList?.getInstance(el);
                        if (tree) { tree.updateDimensions(); tree.repaint(); }
                    });
                }

                function applyDxTheme() {
                    if (!dxThemeLink) return;
                    dxThemeLink.href = isDark() ? DX_DARK : DX_LIGHT;
                    setTimeout(updateAllDxTables, 80);
                }

                function applyDxRTL() {
                    const rtl = isRTL();
                    DevExpress.config({ rtlEnabled: rtl });

                    document.querySelectorAll(".dx-datagrid").forEach(el => {
                        const grid = DevExpress.ui.dxDataGrid.getInstance(el);
                        if (grid) grid.option("rtlEnabled", rtl);
                    });

                    document.querySelectorAll(".dx-treelist").forEach(el => {
                        const tree = DevExpress.ui.dxTreeList?.getInstance(el);
                        if (tree) tree.option("rtlEnabled", rtl);
                    });

                    updateAllDxTables();
                }

                function applyDxLocale() {
                    if (window.DevExpress?.localization) {
                        DevExpress.localization.locale(htmlRoot.lang || "en");
                    }
                }

                if (DevExpress.ui.dxDataGrid?.defaultOptions) {
                    DevExpress.ui.dxDataGrid.defaultOptions({
                        device: () => isPhone(),
                        options: {
                            width: "100%",
                            columnHidingEnabled: true,
                            columnAutoWidth: true,
                            wordWrapEnabled: true,
                            scrolling: { useNative: true, showScrollbar: "always" },
                            hoverStateEnabled: false,
                            rowAlternationEnabled: false,
                            columnChooser: { enabled: true, mode: "select" },
                            rtlEnabled: isRTL()
                        }
                    });
                }

                if (DevExpress.ui.dxTreeList?.defaultOptions) {
                    DevExpress.ui.dxTreeList.defaultOptions({
                        device: () => isPhone(),
                        options: {
                            width: "100%",
                            columnHidingEnabled: true,
                            columnAutoWidth: true,
                            wordWrapEnabled: true,
                            scrolling: { useNative: true, showScrollbar: "always" },
                            rtlEnabled: isRTL()
                        }
                    });
                }

                applyDxLocale();
                applyDxTheme();
                applyDxRTL();

                let lastTheme = htmlRoot.getAttribute("data-bs-theme") || "light";
                let lastDir = htmlRoot.getAttribute("dir") || "ltr";

                new MutationObserver(() => {
                    const newTheme = htmlRoot.getAttribute("data-bs-theme") || "light";
                    const newDir = htmlRoot.getAttribute("dir") || "ltr";

                    if (newTheme !== lastTheme) { applyDxTheme(); lastTheme = newTheme; }
                    if (newDir !== lastDir) { applyDxRTL(); lastDir = newDir; }
                }).observe(htmlRoot, { attributes: true, attributeFilter: ["data-bs-theme", "dir"] });

                let resizeTimer;
                window.addEventListener("resize", () => {
                    clearTimeout(resizeTimer);
                    resizeTimer = setTimeout(updateAllDxTables, 200);
                });

                window.addEventListener("orientationchange", () => {
                    setTimeout(updateAllDxTables, 250);
                });
            });
            /* End DevExtreme Global RTL + Dark + Responsive */

            // Stop DataTables from showing alert() popups
            $.fn.dataTable.ext.errMode = 'none';
            $(document).on('error.dt', function (e, settings, techNote, message) {
                console.warn('DataTables:', message);
            });
        </script>

        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>
