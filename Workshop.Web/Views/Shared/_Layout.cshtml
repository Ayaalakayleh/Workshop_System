                        var link = "";
                        if (string.IsNullOrEmpty(i.ControllerName))
                        {
                            link = "#";
                        }
                        else
                        {
                            link = Url.Action(i.MethodName, i.ControllerName);
                        }
                        <li class=@(link !="#"?"":"nav-item")>
                            <a href="@link" title='@(lang == "en" ? i.PrimaryName : i.SecondarName)' data-filter-tags>
                                <i class="@i.Icon"></i>

                                <span class="nav-link-text" data-i18n>@(lang == "en" ? i.PrimaryName : i.SecondarName)</span>
                            </a>
                            @if (link =="#")
                            {
                                  <ul>

                                @foreach (var j in menus.Where(a => a.ParentId == i.Id).ToList().OrderBy(c => c.Seq))
                                {
                                    var link1 = "";
                                    if (string.IsNullOrEmpty(j.ControllerName))
                                    {
                                        link1 = "#";
                                    }
                                    else
                                    {
                                        link1 = Url.Action(j.MethodName, j.ControllerName);
                                    }
                                    <li>
                                        <a href="@link1">
                                            <i class="@j.Icon"></i>
                                            <span class="nav-link-text" data-i18n>@(lang == "en" ? j.PrimaryName : j.SecondarName)</span>
                                        </a>
                                            @if (link1 == "#")
                                            {
                                                <ul>

                                                    @foreach (var g in menus.Where(a => a.ParentId == j.Id).ToList().OrderBy(c => c.Seq))
                                                    {
                                                        var link2 = "";
                                                        if (string.IsNullOrEmpty(g.ControllerName))
                                                        {
                                                            link2 = "#";
                                                        }
                                                        else
                                                        {
                                                            link2 = Url.Action(g.MethodName, g.ControllerName);
                                                        }
                                                        <li class="link-item">
                                                            <a href="@link2">
                                                                <i class="@g.Icon"></i>
                                                                <span class="nav-link-text" data-i18n>@(lang == "en" ? g.PrimaryName : g.SecondarName)</span>
                                                            </a>
                                                        </li>
                                                    }



                                                </ul>
                                            }
                                        </li>
                                }



                                </ul>
                            }
                          
                        </li>
                    }
                    
                   
