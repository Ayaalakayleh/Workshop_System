(function () {
    // Allowed KSA plate letters (Latin, from your table)
    const KSA_ALLOWED_LATIN = "ABJDRSXTEGKLZNHUV";

    // Latin -> Arabic letters (Saudi plate mapping)
    const letterToArabic = {
        A: "ا",
        B: "ب",
        J: "ح",
        D: "د",
        R: "ر",
        S: "س",
        X: "ص",
        T: "ط",
        E: "ع",
        G: "ق",
        K: "ك",
        L: "ل",
        Z: "م",
        N: "ن",
        H: "ه",
        U: "و",
        V: "ى"
    };

    // Western digits -> Arabic-Indic digits
    const digitToArabic = {
        "0": "٠", "1": "١", "2": "٢", "3": "٣", "4": "٤",
        "5": "٥", "6": "٦", "7": "٧", "8": "٨", "9": "٩"
    };

    // Arabic letters allowed in the mask (exact Arabic equivalents of your allowed Latin set)
    // + optional "ي" as a common keyboard alternative for "ى" (will stay as-is in Arabic output)
    const KSA_ALLOWED_ARABIC = Object.values(letterToArabic).join("") + "ي";

    // Arabic-Indic digits allowed in the numeric part
    const ARABIC_INDIC_DIGITS = "٠١٢٣٤٥٦٧٨٩";

    function toArabicPlate(value) {
        if (!value) return "";

        // Remove mask placeholders
        const cleaned = value.replace(/_/g, "");

        let out = "";
        for (const ch of cleaned) {
            const up = ch.toUpperCase();

            // Convert ONLY English letters/digits -> Arabic
            if (letterToArabic[up]) out += letterToArabic[up];
            else if (digitToArabic[ch]) out += digitToArabic[ch];

            // If already Arabic (letters/digits), keep as-is
            else out += ch; // keep spaces/dash/Arabic chars as-is
        }
        return out;
    }

    function syncArabicField() {
        const val = $("#PlateNumber").val() || "";
        const ar = toArabicPlate(val);

        $("#PlateNumberAr").val(ar);

        // Optional preview (safe even if #plateText doesn't exist)
        $("#plateText").text(ar);
    }

    // Keep your old button working (if present in some branch)
    window.convertPlateNumber = function () {
        syncArabicField();
    };

    $(function () {
        // Inputmask: 9999 - L L L where:
        // - 9 allows Western OR Arabic-Indic digits
        // - L allows allowed Latin letters OR their Arabic equivalents
        $(".plate-mask").inputmask("9999 - L L L", {
            definitions: {
                "9": {
                    validator: "[0-9" + ARABIC_INDIC_DIGITS + "]"
                },
                "L": {
                    validator: function (ch) {
                        if (!ch) return false;

                        const up = ch.toUpperCase();

                        // Accept Latin allowed OR Arabic allowed
                        return (
                            KSA_ALLOWED_LATIN.indexOf(up) !== -1 ||
                            KSA_ALLOWED_ARABIC.indexOf(ch) !== -1
                        );
                    },
                    casing: "upper" // affects Latin only; Arabic unchanged
                }
            },
            placeholder: "_",
            clearIncomplete: true,
            onBeforePaste: function (pastedValue) {
                // Keep only:
                // - Western digits 0-9
                // - Arabic-Indic digits
                // - allowed Latin letters
                // - allowed Arabic letters
                // - spaces and dash
                const re = new RegExp(
                    "[^0-9" +
                        ARABIC_INDIC_DIGITS +
                        KSA_ALLOWED_LATIN +
                        KSA_ALLOWED_ARABIC +
                        "\\s\\-]",
                    "g"
                );

                return (pastedValue || "")
                    .toUpperCase() // Latin only
                    .replace(re, "");
            }
        });

        // Live convert while typing
        $(document).on("input keyup change", "#PlateNumber", syncArabicField);

        // Initial fill (in case Model.PlateNumber has value)
        syncArabicField();
    });
})();

  
</script>

<script>
    (() => {
        const themeBase = '@Url.Content("~/smartadmin-5-styles/css/themes/")';
        const themeLink = document.getElementById('theme-style');

        const storageKey = 'sa-theme-style';
        const defaultTheme = 'earth';

        function applyTheme(theme) {
            const t = (theme || defaultTheme).toLowerCase();
            themeLink.href = `${themeBase}${t}.css`;
            localStorage.setItem(storageKey, t);

            document.querySelectorAll('input[data-action="theme-style"]').forEach(r => {
                r.checked = ((r.dataset.themeStyle || '').toLowerCase() === t);
            });
        }

        applyTheme(localStorage.getItem(storageKey));

        document.addEventListener('change', (e) => {
            const el = e.target;
            if (el && el.matches('input[data-action="theme-style"]')) {
                e.stopImmediatePropagation();
                applyTheme(el.dataset.themeStyle);
            }
        }, true);
    })();
    /*Start fix change Lang/Branch on mobile menu*/
    document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll(".dropdown-menu .dropdown-toggle").forEach((toggle) => {

    toggle.addEventListener("click", (e) => {
      if (window.innerWidth > 576) return;

      e.preventDefault();
      e.stopPropagation();

      const parentLi = toggle.closest(".dropdown-submenu") || toggle.parentElement;
      const submenu = toggle.nextElementSibling;

      if (!submenu || !submenu.classList.contains("dropdown-menu")) return;

      parentLi.classList.toggle("show");
      submenu.classList.toggle("show");
    });
  });
  document.querySelectorAll(".dropdown").forEach((dd) => {
    dd.addEventListener("hidden.bs.dropdown", () => {
      dd.querySelectorAll(".dropdown-submenu.show").forEach((el) => el.classList.remove("show"));
      dd.querySelectorAll(".dropdown-menu.show").forEach((el) => {
        if (el.closest(".dropdown-submenu")) el.classList.remove("show");
      });
    });
  });

});
