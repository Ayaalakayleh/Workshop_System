<script>
function resetToEarthTheme() {
    const KEY = 'sa-theme-style';
    const theme = 'earth';
    const base = '@Url.Content("~/smartadmin-5-styles/css/themes/")';

    localStorage.setItem(KEY, theme);

    const link = document.getElementById('theme-style');
    if (link) link.href = base + theme + '.css';

    // sync radio button
    document.querySelectorAll('input[data-action="theme-style"]').forEach(r => {
        r.checked = ((r.dataset.themeStyle || '').toLowerCase() === theme);
    });
}
</script>
