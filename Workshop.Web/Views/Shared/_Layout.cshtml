          <script>
(function () {
  const KEY = 'sa-theme-style';
  const DEFAULT = 'earth';
  const THEMES = ['earth','olive','nebula','solar','lunar','night','aurora','flare','storm'];
  const base = '@Url.Content("~/smartadmin-5-styles/css/themes/")';

  let saved = localStorage.getItem(KEY);

  // ✅ Force earth if nothing saved
  if (!saved || !THEMES.includes(saved)) {
    saved = DEFAULT;
    localStorage.setItem(KEY, DEFAULT);
  }

  const link = document.getElementById('theme-style');
  if (link) link.href = base + saved + '.css';
})();
</script>

