@using Workshop.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Common> Common
@inject IStringLocalizer<Messages> Message

<div class="row">
    <div class="col-lg-3 col-md-6 col-sm-12">
        <div class="form-group">
            <label>@Common["Label_WIPNumber"]</label>
            <input type="number" id="WIP" name="WIP" class="form-control" placeholder="e.g. 12345">
        </div>
    </div>
    <div class="col-lg-3 col-md-6 col-sm-12">
        <div class="form-group">
            <label>@Common["Label_FromDate"]</label>
            <input type="date" id="InvoiceDateStart" name="InvoiceDateStart" class="form-control flat-picker">
        </div>
    </div>
    <div class="col-lg-3 col-md-6 col-sm-12">
        <div class="form-group">
            <label>@Common["Label_ToDate"]</label>
            <input type="date" id="InvoiceDateEnd" name="InvoiceDateEnd" class="form-control flat-picker">
        </div>
    </div>
    <div class="col-lg-3 col-md-6 col-sm-12">
        <div class="form-group">
            <label>@Common["Label_Customer"]</label>
            @* <input type="number" id="CustomerId" name="CustomerId" class="form-control" placeholder="Customer ID"> *@
            @Html.DropDownList(
                        "CustomerId",
                        (IEnumerable<SelectListItem>)ViewBag.Customers,
                        Common["Label_Select"],
                        new { @class = "form-control" }
                        )
        </div>
    </div>
</div>
<div class="text-center mt-3">
    <button class="btn btn-primary" id="btnSearchReport"><i class="fad fa-search"></i>&nbsp;@Common["Button_Search"]</button>
    <button type="button" class="btn btn-secondary" id="btnResetSearch">
        <i class="fad fa-times"></i>&nbsp;@Common["Button_Reset"]
    </button>
</div>
