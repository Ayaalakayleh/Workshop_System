@model IEnumerable<Workshop.Core.DTOs.WIPReportDTO>
@using Workshop.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Common> Common
@inject IStringLocalizer<Messages> Message

<table class="table table-bordered table-hover text-center w-100 main-table">
    <thead>
        <tr>
            <th>@Common["Label_WIP"]</th>
            <th>@Common["Label_Status"]</th>
            <th>@Common["Label_CreatedDate"]</th>
            <th>@Common["Label_DueIn"]</th>
            <th>@Common["Label_DueOut"]</th>
            <th>@Common["Label_Ageing"]</th>
            <th>@Common["Label_CustomerName"]</th>
            <th>@Common["Label_TotalAmount"]</th>
            <th>@Common["Label_TotalLabours"]</th>
            <th>@Common["Label_TotalParts"]</th>
            <th>@Common["Label_VIN"]</th>
            <th>@Common["Label_PlateNumber"]</th>
            <th>@Common["Label_Make"]</th>
            <th>@Common["Label_Model"]</th>
            <th>@Common["Label_ServiceAdvisor"]</th>
            <th>@Common["Label_Branch"]</th>
            <th>@Common["Label_VehcileIn/Out"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.WIP</td>
                    <td>@item.Status</td>
                    <td>@item.CreatedDate?.ToString("yyyy-MM-dd")</td>
                    <td>@item.DueIn</td>
                    <td>@item.DueOut</td>
                    <td>@item.Ageing</td>
                    <td>@item.CustomerName</td>
                    <td>@item.TotalAmount?.ToString("N2")</td>
                    <td>@item.TotalLabours?.ToString("N2")</td>
                    <td>@item.TotalParts?.ToString("N2")</td>
                    <td>@item.VIN</td>
                    <td>@item.PlateNumber</td>
                    <td>@item.Make</td>
                    <td>@item.Model</td>
                    <td>@item.ServiceAdvisor</td>
                    <td>@item.Branch</td>
                    <td>@item.VehicleInOut</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="16">@Common["NoData"]</td>
            </tr>
        }
    </tbody>
</table>
