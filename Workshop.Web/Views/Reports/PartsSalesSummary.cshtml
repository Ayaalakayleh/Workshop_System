@using Workshop.Core.DTOs 
@using Workshop.Resources
@using Microsoft.Extensions.Localization 
@inject IStringLocalizer<Common> Common 
@inject IStringLocalizer<Messages> Message


<div id="panel-1" class="panel">
    <div class="panel-hdr">
        <h2 class="font-weight-bold">@Common["PartsSummaryReport"]</h2>
    </div>
    <div class="panel-container show">
        <div class="panel-content">
@* <form asp-action="PartsSalesSummary" method="post" target="_blank"> *@
                <form asp-controller="Reports"
                      asp-action="PartsSalesSummary"
                      method="post"
                      target="_blank">
    <div class="row g-3">

        <div class="col-md-3">
                        <label>@Common["Label_FromDate"]</label>
            <input type="text" name="FromDate" class="form-control flat-picker" />
        </div>

        <div class="col-md-3">
                        <label>@Common["Label_ToDate"]</label>
            <input type="text" name="ToDate" class="form-control flat-picker" />
        </div>

        <div class="col-md-3">
                        <label>@Common["Label_AccountType"]</label>
            @Html.DropDownList("AccountType",
                        (IEnumerable<SelectListItem>)ViewBag.AccountTypes,
                        "-- Select --",
                        new { @class = "form-control", id = "AccountType" })
        </div>

        <div class="col-md-3">
                        <label>@Common["SalesType"]</label>
                        <select id="SalesType" name="SalesType" class="form-control">
                <option value="">-- Select --</option>
            </select>
        </div>

        <div class="col-md-3">
                <input type="checkbox" name="IsAll" value="true" class="form-check-input" id="IsAll" />
                        <label class="form-check-label" for="IsAll">@Common["Label_All"]</label>
           </div>

                    <div class="col-md-3">
                <input type="checkbox" name="IsWIPClose" value="true" class="form-check-input" id="IsWIPClose" />
                        <label class="form-check-label" for="IsWIPClose">@Common["WIPClose"]</label>
            </div>
                  




    </div>
                <div class="text-center mt-3">
               @*      <button type="submit" class="btn btn-success ml-2">
                        <i class="fa fa-print"></i>&nbsp;@Common["Button_Print"]
                    </button> *@
                    <div class="text-center mt-3">

                        <button class="btn btn-pdf btn-w-m" value="pdf" name="ReportType" type="submit">
                            <i class="fa fa-file-pdf"></i>&nbsp; PDF
                        </button>

                        <button class="btn btn-excel btn-w-m" value="excel" name="ReportType" type="submit">
                            <i class="fa fa-file-excel"></i>&nbsp; Excel
                        </button>

                        <button class="btn btn-primary btn-w-m" value="preview" name="ReportType" type="submit">
                            <i class="fa fa-eye"></i>&nbsp; Preview
                        </button>

                    </div>
                </div>
</form>
</div>
</div>
</div>
<script src="~/js/site.js"></script>
<script src="~/js/Definitions/reports.js"></script>
<script>
    $(document).ready(function () {

        window.appUrls = {
            getSalesType: '@Url.Action("GetSalesType", "WIP")'
        };


        function loadSalesTypes(accountId, $ddl) {
            const prev = $ddl.val();
            $.getJSON(window.appUrls.getSalesType, { accountId: accountId })
                .done(function (data) {
                    $ddl.empty().append($('<option>', { value: "", text: "-- Select --" }));
                    $.each(data, function (i, item) {
                        $ddl.append($('<option>', { value: item.value, text: item.text }));
                    });
                    if (prev) $ddl.val(prev);
                });
        }

     
        $("#AccountType").change(function () {
            const accountId = $(this).val();
            loadSalesTypes(accountId, $("#SalesType"));
        });


        if ($("#AccountType").val()) {
            loadSalesTypes($("#AccountType").val(), $("#SalesType"));
        }
    });
</script>