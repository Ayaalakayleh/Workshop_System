@model IEnumerable<Workshop.Core.DTOs.MonthlyRepairCostReportDTO>
@using Workshop.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Common> Common
@inject IStringLocalizer<Messages> Message

<table class="table table-bordered table-hover text-center w-100 main-table">
    <thead>
        <tr>
            <th>@Common["Label_WIP"]</th>
            <th>@Common["Label_InvoiceDate"]</th>
            <th>@Common["Label_InvoiceNumber"]</th>
            <th>@Common["Label_CompanyCode"]</th>
            <th>@Common["Label_Account"]</th>
            <th>@Common["Label_Department"]</th>
            <th>@Common["Label_CustomerName"]</th>
            <th>@Common["Label_TotalAmount"]</th>
            <th>@Common["Label_TotalLabours"]</th>
            <th>@Common["Label_TotalParts"]</th>
            <th>@Common["Label_VIN"]</th>
            <th>@Common["Label_PlateNumber"]</th>
            <th>@Common["Label_ManufacturerYear"]</th>
            <th>@Common["Label_OPNumber"]</th>
            <th>@Common["Label_OPName"]</th>
            <th>@Common["Label_ServiceCode"]</th>
            <th>@Common["Label_ServiceDescription"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.WIP</td>
                    <td>@item.InvoiceDate.ToString("yyyy-MM-dd")</td>
                    <td>@item.InvoiceNumber</td>
                    <td>@item.CompanyCode</td>
                    <td>@item.Account</td>
                    <td>@item.Department</td>
                    <td>@item.CustomerName</td>
                    <td>@item.TotalAmount?.ToString("N2")</td>
                    <td>@item.TotalLabours?.ToString("N2")</td>
                    <td>@item.TotalParts?.ToString("N2")</td>
                    <td>@item.VIN</td>
                    <td>@item.PlateNumber</td>
                    <td>@item.ManufactureYear</td>
                    <td>@item.OPNumber</td>
                    <td>@item.OPName</td>
                    <td>@item.VehServiceCode</td>
                    <td>@item.VehServiceDesc</td>
                </tr>
            }
        }
    </tbody>
</table>
