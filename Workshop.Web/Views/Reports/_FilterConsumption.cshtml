@using Workshop.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Common> Common
@inject IStringLocalizer<Messages> Message

<div class="row">
    <div class="col-md-3">
        <div class="form-group">
            <label>@Common["WIP Number"]</label>
            <input type="number" id="WIP" name="WIP" class="form-control" placeholder="e.g. 12345">
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label>@Common["Invoice Date From"]</label>
            <input type="date" id="InvoiceDateStart" name="InvoiceDateStart" class="form-control">
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label>@Common["Invoice Date To"]</label>
            <input type="date" id="InvoiceDateEnd" name="InvoiceDateEnd" class="form-control">
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label>@Common["Customer"]</label>
            @Html.DropDownList(
                        "CustomerId",
                        (IEnumerable<SelectListItem>)ViewBag.Customers,
                        "Select Customer",
                        new { @class = "form-control" }
                        )
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label>@Common["Type"]</label>
             @Html.DropDownList(
                "TypeId",
                (IEnumerable<SelectListItem>)ViewBag.AccountTypes,
                "Select Type",
                new { @class = "form-control" }
            )
        </div>
    </div>
</div>
<div class="text-center mt-3">
    <button class="btn btn-primary" id="btnSearchReport"><i class="fad fa-search"></i>&nbsp;@Common["Button_Search"]</button>
    <button type="button" class="btn btn-secondary" id="btnResetSearch">
        <i class="fad fa-times"></i>&nbsp;@Common["Button_Reset"]
    </button>
</div>
